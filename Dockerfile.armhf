FROM debian:12

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        pkg-config \
        qtbase5-dev \
        qt5-qmake \
        qtbase5-dev-tools \
        qml \
        qtdeclarative5-dev \
        libgpiod-dev \
        gpiod \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

RUN gcc --version \
    && cmake -S . -B build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build --parallel
