/dts-v1/;

/ {
	#address-cells = <0x01>;
	#size-cells = <0x01>;
	model = "STMicroelectronics STM32MP135F-DK Discovery Board";
	compatible = "st,stm32mp135f-dk\0st,stm32mp135";

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			compatible = "arm,cortex-a7";
			device_type = "cpu";
			reg = <0x00>;
			clocks = <0x01 0x00>;
			clock-names = "cpu";
			nvmem-cells = <0x02>;
			nvmem-cell-names = "part_number";
			#cooling-cells = <0x02>;
			phandle = <0x03>;
		};
	};

	arm-pmu {
		compatible = "arm,cortex-a7-pmu";
		interrupts = <0x00 0x85 0x04>;
		interrupt-affinity = <0x03>;
		interrupt-parent = <0x04>;
	};

	sram@2ffff000 {
		compatible = "mmio-sram";
		reg = <0x2ffff000 0x1000>;
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x2ffff000 0x1000>;
		phandle = <0x64>;

		scmi_shm@0 {
			compatible = "arm,scmi-shmem";
			reg = <0x00 0x80>;
			phandle = <0x05>;
		};
	};

	firmware {

		optee {
			method = "smc";
			compatible = "linaro,optee-tz";
			interrupt-parent = <0x04>;
			interrupts = <0x01 0x0f 0x108>;
			interrupt-controller;
			#interrupt-cells = <0x01>;
			phandle = <0x65>;
		};

		scmi {
			compatible = "linaro,scmi-optee";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			linaro,optee-channel-id = <0x00>;
			shmem = <0x05>;
			phandle = <0x66>;

			protocol@13 {
				reg = <0x13>;
				#clock-cells = <0x01>;
				phandle = <0x01>;
			};

			protocol@14 {
				reg = <0x14>;
				#clock-cells = <0x01>;
				phandle = <0x24>;
			};

			protocol@16 {
				reg = <0x16>;
				#reset-cells = <0x01>;
				phandle = <0x5b>;
			};

			protocol@17 {
				reg = <0x17>;
				phandle = <0x67>;

				regulators {
					phandle = <0x68>;

					voltd-reg11 {
						voltd-name = "reg11";
						regulator-name = "reg11";
						phandle = <0x4a>;
					};

					voltd-reg18 {
						voltd-name = "reg18";
						regulator-name = "reg18";
						phandle = <0x4b>;
					};

					voltd-usb33 {
						voltd-name = "usb33";
						regulator-name = "usb33";
						phandle = <0x2f>;
					};

					voltd-vddcpu {
						voltd-name = "vddcpu";
						regulator-name = "vddcpu";
						phandle = <0x69>;
					};

					voltd-vdd {
						voltd-name = "vdd";
						regulator-name = "vdd";
						phandle = <0x6a>;
					};

					voltd-vddcore {
						voltd-name = "vddcore";
						regulator-name = "vddcore";
						phandle = <0x6b>;
					};

					voltd-vdd_adc {
						voltd-name = "vdd_adc";
						regulator-name = "vdd_adc";
						phandle = <0x50>;
					};

					voltd-vdd_usb {
						voltd-name = "vdd_usb";
						regulator-name = "vdd_usb";
						phandle = <0x4c>;
					};

					voltd-vdd_sd {
						voltd-name = "vdd_sd";
						regulator-name = "vdd_sd";
						phandle = <0x40>;
					};

					voltd-v1v8_periph {
						voltd-name = "v1v8_periph";
						regulator-name = "v1v8_periph";
						phandle = <0x6c>;
					};

					voltd-v3v3_sw {
						voltd-name = "v3v3_sw";
						regulator-name = "v3v3_sw";
						phandle = <0x4d>;
					};
				};
			};
		};
	};

	interrupt-controller@a0021000 {
		compatible = "arm,cortex-a7-gic";
		#interrupt-cells = <0x03>;
		interrupt-controller;
		reg = <0xa0021000 0x1000 0xa0022000 0x2000>;
		phandle = <0x04>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	timer {
		compatible = "arm,armv7-timer";
		interrupts = <0x01 0x0d 0x108 0x01 0x0e 0x108 0x01 0x0b 0x108 0x01 0x0a 0x108>;
		interrupt-parent = <0x04>;
		always-on;
	};

	pm_domain {
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		compatible = "st,stm32mp157c-pd";

		core-ret-power-domain@1 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x01>;
			#power-domain-cells = <0x00>;
			label = "CORE-RETENTION";
			phandle = <0x0d>;

			core-power-domain@2 {
				reg = <0x02>;
				#power-domain-cells = <0x00>;
				label = "CORE";
				phandle = <0x30>;
			};
		};
	};

	thermal-zones {

		cpu-thermal {
			polling-delay-passive = <0x00>;
			polling-delay = <0x00>;
			thermal-sensors = <0x06>;
			phandle = <0x6d>;

			trips {

				cpu-alert0 {
					temperature = <0x17318>;
					hysteresis = <0x2710>;
					type = "passive";
					phandle = <0x07>;
				};

				cpu-crit0 {
					temperature = <0x1d4c0>;
					hysteresis = <0x00>;
					type = "critical";
					phandle = <0x6e>;
				};
			};

			cooling-maps {

				map0 {
					trip = <0x07>;
					cooling-device = <0x03 0x01 0x01>;
				};
			};
		};
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		interrupt-parent = <0x04>;
		ranges;

		sram@30000000 {
			compatible = "mmio-sram";
			reg = <0x30000000 0x8000>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges = <0x00 0x30000000 0x8000>;
			phandle = <0x6f>;

			dma-sram@0 {
				reg = <0x00 0x4000>;
				pool;
				phandle = <0x2a>;
			};
		};

		timer@40000000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "st,stm32-timers";
			reg = <0x40000000 0x400>;
			clocks = <0x08 0x69>;
			clock-names = "int";
			status = "disabled";
			phandle = <0x70>;

			pwm {
				compatible = "st,stm32-pwm";
				#pwm-cells = <0x03>;
				status = "disabled";
				pinctrl-0 = <0x09>;
				pinctrl-1 = <0x0a>;
				pinctrl-names = "default\0sleep";
			};

			timer@1 {
				compatible = "st,stm32h7-timer-trigger";
				reg = <0x01>;
				status = "disabled";
			};

			counter {
				compatible = "st,stm32-timer-counter";
				status = "disabled";
			};
		};

		timer@40001000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "st,stm32-timers";
			reg = <0x40001000 0x400>;
			clocks = <0x08 0x6a>;
			clock-names = "int";
			dmas = <0x0b 0x17 0x400 0x80000001 0x0b 0x18 0x400 0x80000001 0x0b 0x19 0x400 0x80000001 0x0b 0x1a 0x400 0x80000001 0x0b 0x1b 0x400 0x80000001 0x0b 0x1c 0x400 0x80000001>;
			dma-names = "ch1\0ch2\0ch3\0ch4\0up\0trig";
			status = "disabled";
			phandle = <0x71>;

			pwm {
				compatible = "st,stm32-pwm";
				#pwm-cells = <0x03>;
				status = "disabled";
			};

			timer@2 {
				compatible = "st,stm32h7-timer-trigger";
				reg = <0x02>;
				status = "disabled";
			};

			counter {
				compatible = "st,stm32-timer-counter";
				status = "disabled";
			};
		};

		timer@40002000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "st,stm32-timers";
			reg = <0x40002000 0x400>;
			clocks = <0x08 0x6b>;
			clock-names = "int";
			dmas = <0x0b 0x1d 0x400 0x80000001 0x0b 0x1e 0x400 0x80000001 0x0b 0x1f 0x400 0x80000001 0x0b 0x20 0x400 0x80000001>;
			dma-names = "ch1\0ch2\0ch3\0up";
			status = "disabled";
			phandle = <0x72>;

			pwm {
				compatible = "st,stm32-pwm";
				#pwm-cells = <0x03>;
				status = "disabled";
			};

			timer@3 {
				compatible = "st,stm32h7-timer-trigger";
				reg = <0x03>;
				status = "disabled";
			};

			counter {
				compatible = "st,stm32-timer-counter";
				status = "disabled";
			};
		};

		timer@40003000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "st,stm32-timers";
			reg = <0x40003000 0x400>;
			clocks = <0x08 0x6c>;
			clock-names = "int";
			dmas = <0x0b 0x37 0x400 0x80000001 0x0b 0x38 0x400 0x80000001 0x0b 0x39 0x400 0x80000001 0x0b 0x3a 0x400 0x80000001 0x0b 0x3b 0x400 0x80000001 0x0b 0x3c 0x400 0x80000001>;
			dma-names = "ch1\0ch2\0ch3\0ch4\0up\0trig";
			status = "disabled";
			phandle = <0x73>;

			pwm {
				compatible = "st,stm32-pwm";
				#pwm-cells = <0x03>;
				status = "disabled";
			};

			timer@4 {
				compatible = "st,stm32h7-timer-trigger";
				reg = <0x04>;
				status = "disabled";
			};

			counter {
				compatible = "st,stm32-timer-counter";
				status = "disabled";
			};
		};

		timer@40004000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "st,stm32-timers";
			reg = <0x40004000 0x400>;
			clocks = <0x08 0x6d>;
			clock-names = "int";
			dmas = <0x0b 0x45 0x400 0x80000001>;
			dma-names = "up";
			status = "disabled";
			phandle = <0x74>;

			timer@5 {
				compatible = "st,stm32h7-timer-trigger";
				reg = <0x05>;
				status = "disabled";
			};
		};

		timer@40005000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "st,stm32-timers";
			reg = <0x40005000 0x400>;
			clocks = <0x08 0x6e>;
			clock-names = "int";
			dmas = <0x0b 0x46 0x400 0x80000001>;
			dma-names = "up";
			status = "disabled";
			phandle = <0x75>;

			timer@6 {
				compatible = "st,stm32h7-timer-trigger";
				reg = <0x06>;
				status = "disabled";
			};
		};

		timer@40009000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "st,stm32-lptimer";
			reg = <0x40009000 0x400>;
			interrupts-extended = <0x0c 0x2f 0x04>;
			clocks = <0x08 0x77>;
			clock-names = "mux";
			power-domains = <0x0d>;
			wakeup-source;
			status = "disabled";
			phandle = <0x76>;

			pwm {
				compatible = "st,stm32-pwm-lp";
				#pwm-cells = <0x03>;
				status = "disabled";
			};

			trigger@0 {
				compatible = "st,stm32-lptimer-trigger";
				reg = <0x00>;
				status = "disabled";
			};

			counter {
				compatible = "st,stm32-lptimer-counter";
				status = "disabled";
			};

			timer {
				compatible = "st,stm32-lptimer-timer";
				status = "disabled";
			};
		};

		audio-controller@4000b000 {
			compatible = "st,stm32h7-i2s";
			#sound-dai-cells = <0x00>;
			reg = <0x4000b000 0x400>;
			interrupts = <0x00 0x25 0x04>;
			dmas = <0x0b 0x27 0x400 0x01 0x0b 0x28 0x400 0x01>;
			dma-names = "rx\0tx";
			status = "disabled";
			phandle = <0x77>;
		};

		spi@4000b000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "st,stm32h7-spi";
			reg = <0x4000b000 0x400>;
			interrupts = <0x00 0x25 0x04>;
			clocks = <0x08 0x60>;
			resets = <0x08 0x350b>;
			dmas = <0x0b 0x27 0x400 0x01 0x0b 0x28 0x400 0x01>;
			dma-names = "rx\0tx";
			status = "disabled";
			phandle = <0x78>;
		};

		audio-controller@4000c000 {
			compatible = "st,stm32h7-i2s";
			#sound-dai-cells = <0x00>;
			reg = <0x4000c000 0x400>;
			interrupts = <0x00 0x34 0x04>;
			dmas = <0x0b 0x3d 0x400 0x01 0x0b 0x3e 0x400 0x01>;
			dma-names = "rx\0tx";
			status = "disabled";
			phandle = <0x79>;
		};

		spi@4000c000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "st,stm32h7-spi";
			reg = <0x4000c000 0x400>;
			interrupts = <0x00 0x34 0x04>;
			clocks = <0x08 0x61>;
			resets = <0x08 0x350c>;
			dmas = <0x0b 0x3d 0x400 0x01 0x0b 0x3e 0x400 0x01>;
			dma-names = "rx\0tx";
			status = "disabled";
			phandle = <0x7a>;
		};

		audio-controller@4000d000 {
			compatible = "st,stm32h7-spdifrx";
			#sound-dai-cells = <0x00>;
			reg = <0x4000d000 0x400>;
			clocks = <0x08 0x5e>;
			clock-names = "kclk";
			interrupts = <0x00 0x5f 0x04>;
			dmas = <0x0b 0x5d 0x400 0x01 0x0b 0x5e 0x400 0x01>;
			dma-names = "rx\0rx-ctrl";
			status = "disabled";
			phandle = <0x7b>;
		};

		serial@4000f000 {
			compatible = "st,stm32h7-uart";
			reg = <0x4000f000 0x400>;
			interrupts-extended = <0x0c 0x1c 0x04>;
			clocks = <0x08 0x7e>;
			resets = <0x08 0x350f>;
			wakeup-source;
			power-domains = <0x0d>;
			status = "okay";
			pinctrl-names = "default\0sleep";
			pinctrl-0 = <0x0e>;
			pinctrl-1 = <0x0f>;
			rts-gpios;
			linux,rs485-enabled-at-boot-time;
			phandle = <0x7c>;
		};

		serial@40010000 {
			compatible = "st,stm32h7-uart";
			reg = <0x40010000 0x400>;
			interrupts-extended = <0x0c 0x1e 0x04>;
			clocks = <0x08 0x7f>;
			resets = <0x08 0x3510>;
			wakeup-source;
			power-domains = <0x0d>;
			status = "disabled";
			pinctrl-names = "default\0sleep\0idle";
			pinctrl-0 = <0x10>;
			pinctrl-1 = <0x11>;
			pinctrl-2 = <0x12>;
			phandle = <0x7d>;
		};

		serial@40011000 {
			compatible = "st,stm32h7-uart";
			reg = <0x40011000 0x400>;
			interrupts-extended = <0x0c 0x1f 0x04>;
			clocks = <0x08 0x80>;
			resets = <0x08 0x3511>;
			wakeup-source;
			power-domains = <0x0d>;
			dmas = <0x0b 0x41 0x400 0x05 0x0b 0x42 0x400 0x01>;
			dma-names = "rx\0tx";
			status = "disabled";
			phandle = <0x7e>;
		};

		i2c@40012000 {
			compatible = "st,stm32mp13-i2c";
			reg = <0x40012000 0x400>;
			interrupt-names = "event\0error";
			interrupts-extended = <0x0c 0x15 0x04 0x04 0x00 0x21 0x04>;
			clocks = <0x08 0x64>;
			resets = <0x08 0x3515>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			st,syscfg-fmp = <0x13 0x04 0x01>;
			i2c-analog-filter;
			power-domains = <0x0d>;
			wakeup-source;
			status = "okay";
			pinctrl-names = "default\0sleep";
			pinctrl-0 = <0x14>;
			pinctrl-1 = <0x15>;
			clock-frequency = <0x186a0>;
			phandle = <0x7f>;
		};

		i2c@40013000 {
			compatible = "st,stm32mp13-i2c";
			reg = <0x40013000 0x400>;
			interrupt-names = "event\0error";
			interrupts-extended = <0x0c 0x16 0x04 0x04 0x00 0x23 0x04>;
			clocks = <0x08 0x65>;
			resets = <0x08 0x3516>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			st,syscfg-fmp = <0x13 0x04 0x02>;
			i2c-analog-filter;
			power-domains = <0x0d>;
			wakeup-source;
			status = "okay";
			pinctrl-names = "default\0sleep";
			pinctrl-0 = <0x16>;
			pinctrl-1 = <0x17>;
			clock-frequency = <0x186a0>;
			phandle = <0x80>;
		};

		serial@40018000 {
			compatible = "st,stm32h7-uart";
			reg = <0x40018000 0x400>;
			interrupts-extended = <0x0c 0x20 0x04>;
			clocks = <0x08 0x82>;
			resets = <0x08 0x3512>;
			wakeup-source;
			power-domains = <0x0d>;
			dmas = <0x0b 0x4f 0x400 0x05 0x0b 0x50 0x400 0x01>;
			dma-names = "rx\0tx";
			status = "disabled";
			phandle = <0x81>;
		};

		serial@40019000 {
			compatible = "st,stm32h7-uart";
			reg = <0x40019000 0x400>;
			interrupts-extended = <0x0c 0x21 0x04>;
			clocks = <0x08 0x83>;
			resets = <0x08 0x3513>;
			wakeup-source;
			power-domains = <0x0d>;
			status = "disabled";
			pinctrl-names = "default\0sleep\0idle";
			pinctrl-0 = <0x18>;
			pinctrl-1 = <0x19>;
			pinctrl-2 = <0x1a>;
			phandle = <0x82>;
		};

		timer@44000000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "st,stm32-timers";
			reg = <0x44000000 0x400>;
			clocks = <0x08 0x72>;
			clock-names = "int";
			status = "disabled";
			phandle = <0x83>;

			pwm {
				compatible = "st,stm32-pwm";
				#pwm-cells = <0x03>;
				status = "disabled";
				pinctrl-0 = <0x1b>;
				pinctrl-1 = <0x1c>;
				pinctrl-names = "default\0sleep";
			};

			timer@0 {
				compatible = "st,stm32h7-timer-trigger";
				reg = <0x00>;
				status = "disabled";
			};

			counter {
				compatible = "st,stm32-timer-counter";
				status = "disabled";
			};
		};

		timer@44001000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "st,stm32-timers";
			reg = <0x44001000 0x400>;
			clocks = <0x08 0x73>;
			clock-names = "int";
			dmas = <0x0b 0x2f 0x400 0x80000001 0x0b 0x30 0x400 0x80000001 0x0b 0x31 0x400 0x80000001 0x0b 0x32 0x400 0x80000001 0x0b 0x33 0x400 0x80000001 0x0b 0x34 0x400 0x80000001 0x0b 0x35 0x400 0x80000001>;
			dma-names = "ch1\0ch2\0ch3\0ch4\0up\0trig\0com";
			status = "disabled";
			phandle = <0x84>;

			pwm {
				compatible = "st,stm32-pwm";
				#pwm-cells = <0x03>;
				status = "disabled";
			};

			timer@7 {
				compatible = "st,stm32h7-timer-trigger";
				reg = <0x07>;
				status = "disabled";
			};

			counter {
				compatible = "st,stm32-timer-counter";
				status = "disabled";
			};
		};

		serial@44003000 {
			compatible = "st,stm32h7-uart";
			reg = <0x44003000 0x400>;
			interrupts-extended = <0x0c 0x1d 0x04>;
			clocks = <0x08 0x81>;
			resets = <0x08 0x354d>;
			wakeup-source;
			power-domains = <0x0d>;
