	chosen {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		framebuffer {
			compatible = "simple-framebuffer";
			clocks = <0x08 0x8a>;
			status = "disabled";
		};
	};

	clocks {
	};

	memory@c0000000 {
		device_type = "memory";
		reg = <0xc0000000 0x20000000>;
	};

	reserved-memory {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		optee_framebuffer@dd000000 {
			reg = <0xdd000000 0x1000000>;
			no-map;
		};

		optee@de000000 {
			reg = <0xde000000 0x2000000>;
			no-map;
		};
	};

	v3v3_ao {
		compatible = "regulator-fixed";
		regulator-name = "v3v3_ao";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		regulator-always-on;
		phandle = <0xfe>;
	};

	v3v3_touch {
		compatible = "regulator-fixed";
		regulator-name = "v3v3";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		regulator-always-on;
		phandle = <0xff>;
	};

	regulator-v1v8_audio {
		compatible = "regulator-fixed";
		regulator-name = "v1v8_audio";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		regulator-always-on;
		regulator-boot-on;
		phandle = <0x100>;
	};

	panel-rgb {
		compatible = "panel-dpi";
		power-supply = <0x4d>;
		data-mapping = "rgb24";
		status = "okay";
		width-mm = <0x140>;
		height-mm = <0xb4>;
		phandle = <0x101>;

		port {

			endpoint {
				remote-endpoint = <0x5f>;
				phandle = <0x5e>;
			};
		};

		panel-timing {
			clock-frequency = <0x46cf710>;
			hactive = <0x500>;
			vactive = <0x2d0>;
			hsync-len = <0x28>;
			hfront-porch = <0x6e>;
			hback-porch = <0xdc>;
			vsync-len = <0x05>;
			vfront-porch = <0x05>;
			vback-porch = <0x14>;
			hsync-active = <0x01>;
			vsync-active = <0x01>;
			de-active = <0x01>;
			pixelclk-active = <0x01>;
		};
	};

	sound0 {
		compatible = "simple-audio-card";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <0x100>;
		simple-audio-card,name = "ns4168-codec";
		status = "okay";

		simple-audio-card,cpu {
			sound-dai = <0x60>;
		};

		simple-audio-card,codec {
			sound-dai = <0x61>;
		};
	};

	sound1 {
		compatible = "simple-audio-card";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <0x100>;
		simple-audio-card,name = "hdmi-codec";
		status = "okay";

		simple-audio-card,cpu {
			sound-dai = <0x62>;
		};

		simple-audio-card,codec {
			sound-dai = <0x63>;
		};
